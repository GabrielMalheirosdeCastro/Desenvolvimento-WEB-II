{
  "name": "site-acolhimento-faesa",
  "version": "1.10.0",
  "private": true,
  "type": "module",
  "description": "Site de Acolhimento FAESA — monorepo (apps/web SPA + apps/api Express + packages/db Prisma).",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w @site-acolhimento/api",
    "dev": "npm run dev -w @site-acolhimento/api",
    "dev:web": "npm run dev -w @site-acolhimento/web",
    "build": "npm run build -w @site-acolhimento/web",
    "prepare-deploy": "npm run build -w @site-acolhimento/web",
    "deploy": "node scripts/deploy.mjs",
    "docker:build": "docker build -t site-acolhimento-faesa:local .",
    "docker:run": "docker run --rm -p 3010:3010 -e NODE_ENV=production site-acolhimento-faesa:local"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GabrielMalheirosdeCastro/Desenvolvimento-WEB-II.git"
  },
  "license": "UNLICENSED",
  "author": "Gabriel Malheiros de Castro <23110145>"
}
